#: admin/agents.php:196
msgid "You do not have permission to upload assistants."
msgstr "Vous n’avez pas l’autorisation de téléverser des assistants."

#: admin/agents.php:202
msgid ""
"Uploading assistant packages requires Agent Builder Pro. In the free plugin,"
" create assistants with the Assistant Trainer. Learn more at agentic-"
"plugin.com"
msgstr ""
"Le téléversement de paquets d’assistants nécessite Agent Builder Pro. Dans "
"l’extension gratuite, créez des assistants avec le Formateur d’assistants. "
"Pour en savoir plus, rendez-vous sur agentic-plugin.com"

#: admin/agents.php:204
msgid "The uploaded file is not a valid .zip archive."
msgstr "Le fichier téléversé n’est pas une archive .zip valide."

#: admin/agents.php:222
msgid "Invalid file upload."
msgstr "Téléversement de fichier invalide."

#: admin/agents.php:250
msgid ""
"The uploaded zip does not contain a valid agent. An agent.php file is "
"required."
msgstr ""
"Le fichier zip téléversé ne contient pas d’agent valide. Un fichier "
"agent.php est requis."

#: admin/agents.php:269
msgid "The agent.php file is missing a required \"Agent Name\" header."
msgstr "Il manque l’en-tête « Agent Name » requis dans le fichier agent.php."

#: admin/agents.php:274
msgid ""
"This agent requires Agent Builder Pro. Download for free at agentic-"
"plugin.com"
msgstr ""
"Cet agent nécessite Agent Builder Pro. Téléchargez-le gratuitement sur "
"agentic-plugin.com"

