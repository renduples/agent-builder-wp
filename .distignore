# Files and folders excluded from the WordPress.org submission zip.
# Used by bin/export-wporg-tree.sh (and `wp dist-archive` if available).

.git
.github
.gitignore
.distignore
bin

# AI coding-tool directories — untracked, but rsync copies the raw working
# tree so anything present on disk at build time ships unless listed here.
.claude
.cursor
.windsurf
.continue
.aider.chat.history.md
.aider.tags.cache.v4
.DS_Store
._*
.phpunit.result.cache
node_modules
vendor
tests
CLAUDE.md
Claude.md
.phpcs.xml
phpcs.xml
phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
composer.lock
package-lock.json

# Unused Chart.js copy (never enqueued).
assets/js/chart.js
assets/js/chart.min.js

# WP-CLI execution surface — self-hosted only (Guideline 8 / Plugin FAQ).
library/tools/run_wp_cli
library/tools/manage_cli_settings
admin/deployment/deployment-cli.php

# Self-hosted/Pro-only code. No-op in this free-tier checkout (these paths
# don't exist here), but this script is also run from the private upstream
# repo where they do — the exclusion has to live here either way.
includes/self-hosted
admin/upgrade-pro.php
